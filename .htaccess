# Bloquea el acceso público a archivos internos del repo (devuelve 403).

Options -Indexes

# Carpetas y archivos ocultos (.git, .claude, .gitignore, .cursorrules, .htaccess, etc.)
# Se excluye .well-known (lo necesita el SSL/Let's Encrypt).
RedirectMatch 403 ^/(?!\.well-known(/|$))(.*/)?\.[^/]
# Capturas de trabajo (no son parte del sitio)
RedirectMatch 403 ^/proyectos/_capture-

# Documentación para agentes de IA, notas y archivos de configuración de proyectos
<FilesMatch "(?i)^(CLAUDE|GEMINI|AGENTS)\.md$|^(package(-lock)?|hyperframes(\.lock)?|meta)\.json$|\.(py|lock)$">
  Require all denied
</FilesMatch>

# Dominio canónico: sin www. (Hostinger ya redirige HTTP -> HTTPS.)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.dastudio\.com\.ar$ [NC]
RewriteRule ^(.*)$ https://dastudio.com.ar/$1 [R=301,L]
